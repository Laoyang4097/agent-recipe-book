{
  "name": "agent-recipe-book",
  "version": "1.0.0",
  "private": true,
  "description": "解题配方库 · 机器可读的踩坑经验库（网站 + MCP Server + 演示 Agent）",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node tests/run-all.js",
    "test:search": "node tests/search-baseline.js && node tests/search-pagination.test.js",
    "test:quarantine": "node tests/search-quarantine.test.js",
    "test:mcp": "node tests/mcp-smoke.js",
    "test:agent": "node tests/agent-prompts.test.js",
    "test:write-mcp": "node tests/write-mcp.test.js",
    "test:verify": "node tests/verify-citations.test.js",
    "test:ingest": "node tests/run-python.js tests/issue_to_recipe.test.py",
    "test:ingest-write": "node tests/run-python.js tests/ingest_write.test.py",
    "lint": "npm run lint:js && npm run lint:py",
    "lint:js": "eslint .",
    "lint:py": "ruff check .",
    "format": "prettier --write . && ruff format .",
    "format:check": "prettier --check . && ruff format --check .",
    "mcp": "node mcp/server.js"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.4",
    "prettier": "3.9.9"
  }
}
