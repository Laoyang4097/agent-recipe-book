# 依赖
node_modules/
.venv/
__pycache__/
*.pyc

# 密钥与凭证（永远不要提交）
.env
.env.*
credentials.json
*.key
*.pem
secrets/

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
npm-debug.log*

# 运行期产物（不入库）
# 缺口日志由 MCP Server 在本地数据目录旁边累积：随运行增长、每次内容不同；
# 且 RECIPE_GAP_LOG_RAW=1 时会含打码后的查询样本。留本地即可，别用 git add -A 带走。
api/gaps.jsonl

# 编辑器
.vscode/
.idea/
*.swp

# 网站离线兜底数据（由 api/experiences.json 生成；不入库以避免与单一真源漂移）
assets/recipes-data.js
*.bak_boundary

# 过程调研稿 / 内部策略（含校内与赛事相关信息，仅本地保留，不外泄到公开仓库）
